APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=db
DB_PORT=1433
DB_DATABASE=GPLX_BAN_MOI
DB_USERNAME=sa
DB_PASSWORD=YourPassword123!
DB_DATABASE_2=GPLX_BAN_CU
DB_DATABASE_3=MANHLINH

# =============================================================================
# KHG GPLX — copy khối này vào .env trên server (đặt ngay sau DB_*)
# Sau khi sửa: php artisan config:clear
#
# Windows IIS (F:\pmgplx) — in biên bản tổng: 1 file PDF nhiều trang
#   Cài LibreOffice + qpdf (hoặc Ghostscript). Chi tiết: laravel/bin/README.md
#
# Docker dev — giữ GOP_FILE + MERGE_DRIVER=pdf, XÓA hoặc comment 3 dòng *_BIN
#   (LibreOffice/qpdf có sẵn trong image sau khi docker compose build)
#
# Chỉ tải ZIP từng file Word (không gộp PDF): đặt BIEN_BAN_TONG_GOP_FILE=false
# =============================================================================

BIEN_BAN_TONG_GOP_FILE=true
BIEN_BAN_TONG_MERGE_DRIVER=pdf
LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
QPDF_BIN=F:\pmgplx\laravel\bin\qpdf.exe
# GHOSTSCRIPT_BIN=C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe

JP2_DECOMPRESS_BIN=
XEONLINE_API_BASE_URL=http://117.2.146.185:7782

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
